*.elc
.emacs.d/**

node_modules/
packages/*/dist/*
# Committed release artifacts (built by CI on release, also by `make build-*` locally)
!packages/emacs-bridge/dist/emacs-bridge.mjs
!packages/emacs-bridge/dist/gravity-server.mjs
emacs-bridge-agents.json
.claude/
*/.claude/
/.opencode/
result
.direnv
.vscode/

# Secrets / sensitive local config — never commit
.env
.env.local
.env.*.local
.envrc
.dev.vars
*.dev.local
*.local.*
*.pem
*.key
secrets/

# Keep example/template files
!.env.example
!.envrc.example
!*.dev.local.example

# Harness EnterWorktree scratch — interactive worktrees, never tracked
.claude/worktrees/

# Loop / swarm scratch (agentic pipeline)
.clanq/
.pi-subagents/

# Taskplane runtime artifacts
.pi/
.worktrees/
.taskplane-tasks/

# Pi extension emitter build artifact (regenerated by build.mjs on every make build-server)
packages/gravity-server/src/pi-driver/emitter-bundle.generated.ts
# Browser client HTML bundle build artifact (regenerated by build.mjs on every make build-server)
packages/gravity-server/src/gateway/client-bundle.generated.ts
